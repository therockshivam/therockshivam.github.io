# Paytm Bus Tracker – Environment Configuration
# Copy this file to .env and fill in values as needed.
# NEVER commit .env to source control.

# ─── Proxy server ────────────────────────────────────────────────────────────
# Port the local proxy server listens on
PORT=3747

# ─── Paytm API ───────────────────────────────────────────────────────────────
# The Paytm travel search endpoint (private, undocumented).
# Requests succeed only when browser session cookies are present.
# This application proxies the request from the same machine where you are
# logged in to travel.paytm.com so the browser's own cookies travel with it.
PAYTM_API_URL=https://travel.paytm.com/bus/v4/search

# ─── Route configuration ─────────────────────────────────────────────────────
SOURCE_DOC_ID=3461
DESTINATION_DOC_ID=2342
TRAVEL_DATE=2026-11-06

# ─── Tracker defaults ────────────────────────────────────────────────────────
# Minimum interval between auto-checks (seconds). Hard floor is 60s.
MIN_INTERVAL_SECONDS=60
DEFAULT_INTERVAL_SECONDS=300

# ─── Database ────────────────────────────────────────────────────────────────
DB_PATH=bus_tracker.db
